# Roblox / Rojo
# Builds do Rojo (artefato, nunca fonte). O place publicado é a fonte de GUI/Workspace,
# não estes arquivos — versionar um .rbxl aqui vira conflito binário garantido.
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
sourcemap.json

# Claude Code
.claude/settings.local.json

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Arte-fonte
# Textura e projeto do Affinity: sobem para o Roblox como decal, e nada aqui os lê.
# O .af sozinho passa de 75MB, e blob em git não sai do histórico depois.
decals/

# Logs
*.log
logs/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Build output
build/
dist/
out/
bin/
obj/

# Dependencies
node_modules/
vendor/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Temp
tmp/
temp/
*.tmp
*.bak
