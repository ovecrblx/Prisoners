{
  "name": "Prisoners-Match",
  "servePort": 34875,
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "$path": "src-match/server"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$path": "src-match/client"
      }
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src-match/shared"
      }
    }
  }
}
